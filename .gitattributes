# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Shell scripts must always use LF, even on Windows
*.sh text eol=lf

# Batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Large generated map data
public/data/osm-power/*.geojson filter=lfs diff=lfs merge=lfs -text
public/data/osm-power/**/*.pbf filter=lfs diff=lfs merge=lfs -text
