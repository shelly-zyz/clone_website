# PostgreSQL connection string. Keep real credentials in .env.local.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Set to true only when the PostgreSQL server supports SSL.
DATABASE_SSL=false

# V11 database Agent. The login must be able to SET ROLE green_agent_ro.
DATA_AGENT_DATABASE_URL=
# Required for the JSON and MCP endpoints in production.
DATA_AGENT_TOKEN=
# Enable only for a 127.0.0.1 listener accessed through private SSH forwarding.
OGW_XIAOYUN_SSH_PREVIEW=false
DATA_AGENT_PI_ENABLED=false
DATA_AGENT_PI_MODEL=deepseek-flash
DATA_AGENT_PI_THINKING_LEVEL=off
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Separate logins with membership in green_agent_context and green_agent_review.
DATA_AGENT_STATE_DATABASE_URL=
DATA_AGENT_REVIEW_DATABASE_URL=
DATA_AGENT_REVIEW_TOKEN=
# Worker-only login with membership in green_agent_ingest.
DATA_AGENT_INGEST_DATABASE_URL=

# V11 analysis Agent worker. Connect as a login with membership in
# green_agent_ingest; it claims tasks from results.analysis_job in PostgreSQL.
OGW_ANALYSIS_PYTHON=/opt/opengridworks-analysis/venv/bin/python
OGW_ANALYSIS_DEVICE=cpu
HF_HOME=/var/lib/opengridworks/huggingface
# Comma-separated forecast models enabled by the API and configured on this Worker.
OGW_ANALYSIS_ENABLED_MODELS=statsforecast
OGW_ANALYSIS_WORKER_MODELS=statsforecast
# NUMBA_CACHE_DIR=/var/cache/opengridworks/numba
# OGW_CHART_ECHARTS_MCP=false

# Weather replay object storage. Set read-only S3 credentials in the web process.
# The import command uses the same names with its separate write credentials.
WEATHER_REPLAY_S3_ENDPOINT=
WEATHER_REPLAY_S3_ACCESS_KEY=
WEATHER_REPLAY_S3_SECRET_KEY=
