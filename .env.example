# PostgreSQL connection string. Keep real credentials in .env.local.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Set to true only when the PostgreSQL server supports SSL.
DATABASE_SSL=false

# V11 database Agent. The login must be able to SET ROLE green_agent_ro.
DATA_AGENT_DATABASE_URL=
# Required for the JSON and MCP endpoints in production.
DATA_AGENT_TOKEN=
DATA_AGENT_PI_ENABLED=false
DATA_AGENT_PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
