# PostgreSQL connection string. Keep real credentials in .env.local.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Set to true only when the PostgreSQL server supports SSL.
DATABASE_SSL=false

# V11 database Agent. The login must be able to SET ROLE green_agent_ro.
DATA_AGENT_DATABASE_URL=
# Required for the JSON and MCP endpoints in production.
DATA_AGENT_TOKEN=
DATA_AGENT_PI_ENABLED=false
DATA_AGENT_PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Separate logins with membership in green_agent_context and green_agent_review.
DATA_AGENT_STATE_DATABASE_URL=
DATA_AGENT_REVIEW_DATABASE_URL=
DATA_AGENT_REVIEW_TOKEN=
# Worker-only login with membership in green_agent_ingest.
DATA_AGENT_INGEST_DATABASE_URL=

# V11 analysis Agent worker. The web process and worker must share this
# mounted SQLite file; use a separate Python environment for model packages.
OGW_AGENT_STATE_DB=/var/lib/opengridworks/agent-state.sqlite
OGW_ANALYSIS_PYTHON=/opt/opengridworks-analysis/venv/bin/python
OGW_ANALYSIS_DEVICE=cpu
HF_HOME=/var/lib/opengridworks/huggingface
