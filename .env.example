# PostgreSQL connection string. Keep real credentials in .env.local.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Set to true only when the PostgreSQL server supports SSL.
DATABASE_SSL=false

# EnergyDataAgent uses a Responses-compatible API to produce strict EnergyIR only.
# Choose one provider. Both the matching key and ENERGY_AGENT_MODEL are required.
ENERGY_AGENT_PROVIDER=openai
OPENAI_API_KEY=
ENERGY_AGENT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek alternative:
# ENERGY_AGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# ENERGY_AGENT_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional provider-neutral endpoint override and timeout (milliseconds).
ENERGY_AGENT_BASE_URL=
ENERGY_AGENT_TIMEOUT_MS=20000
