# PostgreSQL connection string. Keep real credentials in .env.local.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Set to true only when the PostgreSQL server supports SSL.
DATABASE_SSL=false

# Optional energy agent database connection. Its login must be able to SET ROLE green_agent_ro.
# Apply scripts/v11-energy-agent-view.sql to the zyz database first.
ENERGY_DATABASE_URL=

# Live Pi mode is opt-in for the local development server.
ENERGY_PI_ENABLED=false
DEEPSEEK_API_KEY=
ENERGY_PI_MODEL=deepseek-flash
