{
  "name": "ai-website-clone-template",
  "version": "0.4.0",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "build:china-transmission-preview": "node scripts/build-china-transmission-preview.mjs",
    "data:import": "node --max-old-space-size=4096 scripts/import-data-to-postgres.mjs",
    "validate:china-data": "node scripts/validate-china-data.mjs",
    "weather:update": "node scripts/update-weather-earth-data.mjs",
    "carbon:sync": "python scripts/sync-carbon-graced.py",
    "carbon:import": "node scripts/import-carbon-graced.mjs",
    "agent:climate-vre": "python scripts/build-climate-vre-data.py --input \"../data/VRE_gfdl-esm4_ssp126_2021_2060.mat\"",
    "analysis:worker": "node scripts/run-analysis-worker.mjs",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@antv/g2": "5.4.8",
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@base-ui/react": "^1.3.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stylexjs/stylex": "0.19.1",
    "@types/d3-geo": "^3.1.0",
    "@visactor/vchart": "2.2.1",
    "@xiaoyun/voice": "file:vendor/xiaoyun-voice-1.0.0-beta.1-power-earth.4.tgz",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "echarts": "6.1.0",
    "lucide-react": "^1.6.0",
    "maplibre-gl": "^5.24.0",
    "mcp-echarts": "0.7.1",
    "next": "16.2.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
