{
  "name": "ai-website-clone-template",
  "version": "0.4.0",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:china-transmission-preview": "node scripts/build-china-transmission-preview.mjs",
    "data:import": "node --max-old-space-size=4096 scripts/import-data-to-postgres.mjs",
    "validate:china-data": "node scripts/validate-china-data.mjs",
    "validate:china-dashboard": "node --test src/lib/china-dashboard.test.ts && node scripts/validate-china-dashboard.mjs",
    "validate:prediction-api": "node --test src/lib/prediction/status.test.ts src/lib/prediction/baselines.test.ts src/lib/prediction/evaluation.test.ts src/lib/prediction/real-data-backtest.test.ts",
    "validate:forecast-data": "node --test scripts/validate-forecast-training-data.test.mjs && node scripts/validate-forecast-training-data.mjs --audit-workspace",
    "forecast:acquire:hill-of-towie": "node --test scripts/acquire-hill-of-towie.test.mjs scripts/inspect-hill-of-towie-metadata.test.mjs && node scripts/acquire-hill-of-towie.mjs && node scripts/inspect-hill-of-towie-metadata.mjs",
    "forecast:acquire:gfs": "node --test scripts/acquire-hill-of-towie-gfs.test.mjs && node scripts/acquire-hill-of-towie-gfs.mjs --year 2025",
    "forecast:verify:gfs-local": "node scripts/verify-hill-of-towie-gfs-local.mjs",
    "forecast:import:hill-of-towie": "..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe -m unittest scripts/test_import_hill_of_towie_to_postgres.py && ..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe scripts/import_hill_of_towie_to_postgres.py",
    "forecast:verify:hill-of-towie": "node --env-file=.env.local scripts/verify-hill-of-towie-postgres.mjs",
    "forecast:build:pairs": "..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe -m unittest scripts/test_build_hill_of_towie_training_pairs.py scripts/test_import_hill_of_towie_nwp_to_postgres.py && ..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe scripts/build_hill_of_towie_training_pairs.py",
    "forecast:profile:clean-windows": "node --test scripts/profile-hill-of-towie-clean-windows.test.mjs && node scripts/profile-hill-of-towie-clean-windows.mjs",
    "forecast:validate:pairs": "node scripts/validate-forecast-training-data.mjs .forecast-data\\noaa-gfs\\hill-of-towie-2025\\hill-of-towie-2025-training-pairs.ndjson --minimum-days 90",
    "forecast:import:nwp": "..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe -m unittest scripts/test_import_hill_of_towie_nwp_to_postgres.py && ..\\outputs\\20260904-pg-migration\\venv\\Scripts\\python.exe scripts/import_hill_of_towie_nwp_to_postgres.py",
    "forecast:verify:nwp": "node --env-file=.env.local scripts/verify-hill-of-towie-nwp-postgres.mjs",
    "forecast:sdwpf": "node --test scripts/build-sdwpf-pilot.test.mjs && node scripts/build-sdwpf-pilot.mjs && .forecast-data\\model-venv\\Scripts\\python.exe -m unittest scripts/test_train_sdwpf_lightgbm.py && .forecast-data\\model-venv\\Scripts\\python.exe scripts/train_sdwpf_lightgbm.py",
    "weather:update": "node scripts/update-weather-earth-data.mjs",
    "weather:import": "python scripts/import-weather-cache-to-postgres.py",
    "weather:sync": "node scripts/sync-live-weather.mjs",
    "weather:watch": "node scripts/sync-live-weather.mjs --watch --interval-minutes 60",
    "db:backup:client": "node scripts/create-client-pg-backup.mjs",
    "carbon:sync": "python scripts/sync-carbon-graced.py",
    "carbon:import": "node scripts/import-carbon-graced.mjs",
    "climate:import": "python scripts/import-zenodo-climate-projection.py",
    "climate:sync-metadata": "python scripts/sync-zenodo-climate-metadata.py",
    "climate:finalize": "python scripts/finalize-climate-import.py",
    "potential:import": "python scripts/import-renewable-resource-potential.py",
    "catalog:sync": "python scripts/sync-dataset-catalog.py",
    "agent:climate-vre": "python scripts/build-climate-vre-data.py --input \"../data/VRE_gfdl-esm4_ssp126_2021_2060.mat\"",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@types/d3-geo": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.6.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
